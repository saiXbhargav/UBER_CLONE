# Copy to .env and fill in. Everything here works with free services.

# Port the API + Socket.IO server listens on
PORT=4000

# MongoDB connection string (MongoDB Atlas free tier or local: mongodb://127.0.0.1:27017/ride)
DB_CONNECT=mongodb://127.0.0.1:27017/ride

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: free openrouteservice.org key (no credit card).
# Without it the server falls back to Photon (search) and the public OSRM server (routing).
ORS_MAPS_API=

# Optional Redis (free: local redis-server, Docker `redis` image, or Upstash free tier).
# When set, real-time state lives in Redis so you can run several API servers and survive restarts:
# Socket.IO adapter, dispatch job queue, driver GPS (GEO index), active-ride cache, map cache.
# Leave empty to keep that state in memory (fine for a single server).
REDIS_URL=

# Frontend origin(s) allowed by CORS, comma-separated. Leave empty to allow all (dev only).
CLIENT_URL=http://localhost:5173

# Comma-separated emails of RIDER accounts that can open the admin dashboard (/admin)
ADMIN_EMAILS=

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# production enables secure cookies and JSON logs
NODE_ENV=development
